---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Icon from './Icon.astro';
import siteConfig from '../../siteconfig';

const { sections, thoughts } = siteConfig;

const posts = (await getCollection('post')).sort((a, b) => a.data.order - b.data.order);

const prepared = await Promise.all(
  posts.map(async (entry) => ({
    entry,
    slug: entry.id.replace(/\/index$/, ''),
    Content: (await render(entry)).Content,
  }))
);

const frameLabel: Record<string, string> = {
  stamp: '切割邮票边',
  deckle: '手撕毛边',
  hairline: '画廊白边',
};

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit' }).format(date);
---

<section id="thoughts" class="section section--thoughts">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <div class="section-head__main">
        <p class="eyebrow"><span>{sections.thoughts.index}</span>{sections.thoughts.label}</p>
        <h2 class="section-title">{sections.thoughts.title}</h2>
      </div>
      <div class="section-head__aside">
        <p class="section-lede">{sections.thoughts.intro}</p>
      </div>
    </header>
  </div>

  <div
    class="thoughts-marquee"
    data-thoughts-marquee
    data-reveal
    style={`--thoughts-duration: ${thoughts.marqueeDuration}s; --strip-w: ${thoughts.itemWidth}; --strip-h: ${thoughts.stripHeight};`}
  >
    <div class="thoughts-track" data-thoughts-track>
      {[0, 1].map((copy) => (
        <ul class="thoughts-set" aria-hidden={copy === 1 ? 'true' : undefined}>
          {prepared.map(({ entry, slug }, index) => {
            const data = entry.data;
            return (
              <li class="thought-item">
                <button
                  class="thought-card"
                  type="button"
                  data-sheet={`post:${slug}`}
                  aria-label={`阅读随想：${data.title}`}
                  tabindex={copy === 1 ? -1 : undefined}
                >
                  <span class={`edge-wrap edge-wrap--${data.frame}`}>
                    <span class={`edge edge--${data.frame}`} data-sheet-source>
                      <span class="edge__inner">
                        <Image
                          draggable="false"
                          src={data.cover}
                          alt={data.coverAlt ?? data.title}
                          widths={[320, 560, 760]}
                          sizes="(max-width: 760px) 46vw, 320px"
                          loading={index < 3 && copy === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      </span>
                    </span>
                  </span>

                  <span class="thought-card__label">
                    <span class="thought-card__meta">
                      <span class="thought-card__kind">{frameLabel[data.frame]}</span>
                      <span class="thought-card__dot" aria-hidden="true">·</span>
                      <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
                    </span>
                    <span class="thought-card__title">{data.title}</span>
                  </span>
                </button>
              </li>
            );
          })}
        </ul>
      ))}
    </div>
  </div>

  <div class="wrap">
    <div class="thoughts-foot" data-reveal>
      <p class="thoughts-foot__hint">
        <Icon name="arrow-up-right" size={14} />
        {sections.thoughts.hint}
      </p>
      <p class="thoughts-foot__count">
        <span>{String(prepared.length).padStart(2, '0')}</span>
        篇随想 · 首尾相连
      </p>
    </div>
  </div>

  <!-- SVG filter used by the hand-torn (deckle) edge -->
  <svg class="edge-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <filter id="funiki-deckle" x="-15%" y="-15%" width="130%" height="130%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.022 0.028" numOctaves="3" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>
  </svg>

  {prepared.map(({ entry, Content }) => {
    const data = entry.data;
    const slug = entry.id.replace(/\/index$/, '');
    return (
      <template data-sheet-template={`post:${slug}`} data-sheet-kicker="Thought">
        <article class="post">
          <header class="post__head">
            <p class="post__meta">
              <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
              <span aria-hidden="true">/</span>
              <span>{frameLabel[data.frame]}</span>
            </p>
            <h2 class="post__title">{data.title}</h2>
            {data.excerpt && <p class="post__excerpt">{data.excerpt}</p>}
          </header>

          <figure class={`post__cover edge-wrap edge-wrap--${data.frame}`} data-sheet-source>
            <span class={`edge edge--${data.frame}`}>
              <span class="edge__inner">
                <Image
                  src={data.cover}
                  alt={data.coverAlt ?? data.title}
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 760px) 92vw, 520px"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </span>
          </figure>

          <div class="prose">
            <Content />
          </div>

          <footer class="post__foot">
            <ul class="post__tags">
              {data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <p class="post__end">— 写于某个普通的下午</p>
          </footer>
        </article>
      </template>
    );
  })}
</section>

<style>
  .edge-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* ---------------------------------------------------------- */
  /* horizontal, seamlessly looping strip (auto + drag)         */
  /* ---------------------------------------------------------- */

  .thoughts-marquee {
    position: relative;
    margin-top: clamp(30px, 4.4vw, 56px);
    padding-block: 22px 32px;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 clamp(22px, 5.5vw, 88px),
      #000 calc(100% - clamp(22px, 5.5vw, 88px)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 clamp(22px, 5.5vw, 88px),
      #000 calc(100% - clamp(22px, 5.5vw, 88px)),
      transparent 100%
    );
  }

  .thoughts-marquee.is-dragging {
    cursor: grabbing;
  }

  .thoughts-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .thoughts-set {
    display: flex;
    align-items: flex-end;
    gap: clamp(14px, 1.4vw, 20px);
    padding-right: clamp(14px, 1.4vw, 20px);
  }

  .thought-item {
    flex: 0 0 auto;
    width: var(--strip-w, clamp(220px, 22vw, 320px));
  }

  .thought-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    text-align: left;
    outline-offset: 6px;
  }

  .thoughts-marquee .edge-wrap {
    height: var(--strip-h, clamp(290px, 29vw, 370px));
  }

  .thought-card:hover .edge-wrap {
    transform: translateY(-4px);
  }

  .thought-card:hover .edge__inner img {
    transform: scale(1.03);
  }

  .thought-card__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-inline: 4px;
  }

  .thought-card__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .thought-card__kind {
    color: var(--accent);
  }

  .thought-card__dot {
    opacity: 0.5;
  }

  .thought-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.06rem, 1.3vw, 1.28rem);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .thoughts-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: clamp(22px, 2.8vw, 36px);
    padding-top: clamp(14px, 1.6vw, 20px);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .thoughts-foot__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
  }

  .thoughts-foot__count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    color: var(--ink-4);
  }

  .thoughts-foot__count span {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink);
  }

  /* ---------------------------------------------------------- */
  /* three upright image-edge treatments                        */
  /* ---------------------------------------------------------- */

  .edge-wrap {
    position: relative;
    display: block;
    width: 100%;
    transition: transform 0.6s var(--ease-out);
  }

  .edge {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: var(--paper);
  }

  .edge__inner {
    position: relative;
    display: block;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--paper-sink);
  }

  .edge__inner img {
    -webkit-user-drag: none;
    user-select: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transition: transform 0.8s var(--ease-out);
    will-change: transform;
  }

  /* 1 —— classic cut postage-stamp edge (perforated) */
  .edge-wrap--stamp {
    filter: drop-shadow(0 1px 1px rgba(20, 19, 16, 0.1)) drop-shadow(0 12px 20px rgba(20, 19, 16, 0.07));
  }

  .edge--stamp {
    padding: 16px;
    background: #f3efe6;
  }

  /* white half-circles punched along all four edges = cut stamp perforation */
  .edge--stamp::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 8px 0, #fff 6px, transparent 6.6px),
      radial-gradient(circle at 8px 16px, #fff 6px, transparent 6.6px),
      radial-gradient(circle at 0 8px, #fff 6px, transparent 6.6px),
      radial-gradient(circle at 16px 8px, #fff 6px, transparent 6.6px);
    background-size: 16px 16px;
    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;
    background-position: 0 0, 0 100%, 0 0, 100% 0;
  }

  /* 2 —— hand-torn deckle edge */
  .edge-wrap--deckle {
    filter: drop-shadow(0 1px 1px rgba(20, 19, 16, 0.08)) drop-shadow(0 14px 22px rgba(20, 19, 16, 0.07));
  }

  .edge--deckle {
    padding: 15px;
    background: transparent;
  }

  .edge--deckle::before {
    content: '';
    position: absolute;
    inset: -4px;
    z-index: 0;
    background: #f8f5ef;
    clip-path: polygon(0.3% 0.8%, 5% 0.63%, 10% 0.78%, 15% 1.29%, 20% 0.65%, 25% 0.71%, 30% 0.82%, 35% 0.26%, 40% 0.72%, 45% 0.88%, 50% 1.11%, 55% 0.15%, 60% 0.42%, 65% 0.15%, 70% 1.13%, 75% 0.97%, 80% 0.15%, 85% 1.38%, 90% 1.35%, 95% 0.92%, 99.7% 0.8%, 99.46% 5%, 98.82% 10%, 98.62% 15%, 99.34% 20%, 98.68% 25%, 98.87% 30%, 98.94% 35%, 98.64% 40%, 99.25% 45%, 99.22% 50%, 99.7% 55%, 99.33% 60%, 99.5% 65%, 99.3% 70%, 99.53% 75%, 99.24% 80%, 98.99% 85%, 99.7% 90%, 99.7% 95%, 99.2% 99.7%, 95% 99.7%, 90% 99.59%, 85% 99.04%, 80% 98.92%, 75% 99.0%, 70% 98.7%, 65% 99.67%, 60% 99.16%, 55% 99.7%, 50% 99.14%, 45% 99.7%, 40% 99.7%, 35% 98.6%, 30% 98.89%, 25% 99.7%, 20% 99.26%, 15% 99.7%, 10% 99.16%, 5% 98.7%, 0.3% 99.2%, 0.88% 95%, 1.09% 90%, 0.38% 85%, 0.15% 80%, 0.47% 75%, 1.35% 70%, 1.06% 65%, 0.17% 60%, 0.34% 55%, 0.15% 50%, 0.15% 45%, 1.12% 40%, 0.25% 35%, 0.78% 30%, 0.63% 25%, 0.27% 20%, 1.02% 15%, 0.18% 10%, 0.9% 5%);
  }

  .edge--deckle .edge__inner {
    z-index: 1;
  }

  /* 3 —— gallery print / white mount with a hairline */
  .edge-wrap--hairline {
    filter: drop-shadow(0 10px 18px rgba(20, 19, 16, 0.06));
  }

  .edge--hairline {
    padding: 15px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(20, 19, 16, 0.16),
      0 10px 22px -18px rgba(20, 19, 16, 0.32);
  }

  .edge--hairline .edge__inner {
    outline: 1px solid rgba(20, 19, 16, 0.24);
    outline-offset: 0;
  }

  /* ---------------------------------------------------------- */
  /* sheet cover                                                */
  /* ---------------------------------------------------------- */

  .post__cover.edge-wrap {
    height: auto;
    margin: 0 auto;
    width: min(100%, 520px);
    border-radius: 0;
    overflow: visible;
    background: none;
    box-shadow: none;
  }

  .post__cover .edge {
    height: auto;
  }

  .post__cover .edge__inner {
    flex: 0 0 auto;
    aspect-ratio: 4 / 5;
  }

  /* ---------------------------------------------------------- */
  /* responsive / reduced motion                                */
  /* ---------------------------------------------------------- */

  @media (max-width: 760px) {
    .thoughts-marquee {
      margin-top: 26px;
      padding-block: 16px 24px;
    }

    .thought-item {
      width: clamp(158px, 44vw, 220px);
    }

    .thoughts-marquee .edge-wrap {
      height: clamp(226px, 58vw, 300px);
    }

    .thoughts-set {
      gap: 12px;
      padding-right: 12px;
    }

    .thought-card__title {
      font-size: 1rem;
    }

    .thoughts-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thoughts-marquee {
      overflow-x: auto;
      cursor: default;
    }

    .thoughts-marquee.is-static .thoughts-set[aria-hidden='true'] {
      display: none;
    }

    .thought-card:hover .edge-wrap {
      transform: none;
    }

    .thought-card:hover .edge__inner img {
      transform: none;
    }
  }
</style>